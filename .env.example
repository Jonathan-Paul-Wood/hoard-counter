# Copy to .env. APP_VERSION must identify one immutable local build/release.
APP_VERSION=1.0.0
# Optional registry/repository prefix, for example ghcr.io/your-name/hoard-counter.
IMAGE_PREFIX=hoard-counter
SECRET_KEY=replace-with-a-long-random-secret
WHC_DATA_ROOT=/srv/hoard-counter
HOUSEHOLD_TIMEZONE=America/New_York
# Docker publishes the application at http://localhost:8080 by default.
# Set BIND_ADDRESS to a specific LAN/VPN IP, or 0.0.0.0 for all interfaces.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# False for direct HTTP access; true only when accessing through HTTPS.
COOKIE_SECURE=false
